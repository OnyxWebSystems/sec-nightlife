# Frontend — copy to .env.local for local dev
# Production: set in Vercel → sec-night-life project → Environment Variables, then redeploy.

VITE_API_URL=http://localhost:4000
VITE_PUBLIC_APP_URL=http://localhost:5173

# Cloudinary (browser uploads — unsigned preset only)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=sec_unsigned_uploads

# Google Maps (browser key — restrict to localhost + secnightlife.com)
VITE_GOOGLE_MAPS_API_KEY=

# Optional
# VITE_PAYSTACK_PUBLIC_KEY=pk_test_...
# VITE_SENTRY_DSN=https://...@sentry.io/...

# Production values (Vercel Production only):
# VITE_API_URL=https://api.secnightlife.com
# VITE_PUBLIC_APP_URL=https://secnightlife.com
