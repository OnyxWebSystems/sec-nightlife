# Backend — copy to backend/.env for local dev
# Production: set in Vercel → sec-night-life-2io4 project → Environment Variables

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

JWT_ACCESS_SECRET=generate_64_char_hex_secret
JWT_REFRESH_SECRET=generate_different_64_char_hex_secret

NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Email (required in production)
RESEND_API_KEY=
EMAIL_FROM=SEC Nightlife <noreply@secnightlife.com>

# Cloudinary (strongly recommended in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cron (required in production — Vercel Cron Bearer token)
CRON_SECRET=

# Paystack (when live)
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...

SUPER_ADMIN_EMAIL=admin@secnightlife.com

# Optional
# SENTRY_DSN=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=eu

# NEVER set in production:
# SKIP_EMAIL_VERIFICATION=true
# ALLOW_UNVERIFIED_LOGIN=true

# Production values:
# NODE_ENV=production
# CORS_ORIGIN=https://secnightlife.com
# APP_URL=https://secnightlife.com
